package parism:parser@0.1.0;

/// 외부 파서 게스트가 노출하는 인터페이스.
///
/// ## 왜 이 모양인가
///
/// 게스트는 **원문 문자열 하나를 받아 결과 문자열 하나를 돌려준다** 밖의 일을 하지 않는다.
/// 파일을 직접 읽고, 네트워크에 나가고, 환경 변수를 보는 일은 **전부 호스트의 몫**이다.
/// 게스트가 직접 요구할 수 있는 capability 를 아예 없게 하려면,
/// 인터페이스 자체가 그만큼만 노출해야 한다.
///
/// 게스트가 출력한 결과는 **불신**이다. 파싱은 할 수 있지만 그 결과가 맞는지는
/// 스키마 검사가 정한다. 게스트는 "이건 내가 모르는 형식이다" 라고 말할 수 있어야 한다.
interface parser {
    /// 원문을 파싱해 결과 문자열을 돌려준다.
    ///
    /// 실패하면 **오류를 낸다.** 빈 문자열이나 "아무것도 없다" 를 성공으로 돌려주지 않는다.
    /// "모르는 형식" 과 "빈 결과" 는 다른 사실이다 — 앞자는 실패고 뒤자는 성공이다.
    parse: func(raw: string) -> result<string, string>;
}

/// 호스트가 게스트에 제공하는 인터페이스.
///
/// ## 왜 이게 "전부"인가
///
/// 게스트가 요구할 수 있는 capability 는 이 세 함수와 그것이 받는 것뿐이다.
/// 특히 `secret-exists` 는 **값이 아니라 존재 여부만** 돌려준다.
/// 값까지 주면 그건 가림이 아니라 유출이다 — 게스트는 "이 시크릿이 있나" 를
/// 판단할 수는 있지만 **무엇인지**는 알 수 없다.
///
/// 게스트는 파일·네트워크·환경 변수를 **직접 요구할 수 없다.**
/// 그런 게 필요하다면 호스트가 대신 하고, host capability 로 명시적으로 열어 준다.
/// capability 맵이 비어 있으면 **전부 거부한다**(fail-closed).
interface host {
    /// 호스트 로그에 한 줄 남긴다. 게스트의 디버그 출력 경로다.
    log: func(message: string);

    /// 이름에 해당하는 시크릿이 **존재하는지**만 알려준다.
    /// **값은 주지 않는다.** 존재 여부로 무엇인지는 알 수 없다.
    secret-exists: func(name: string) -> bool;
}

/// 외부 파서 컴포넌트가 지켜야 하는 세계.
///
/// 게스트는 `parser` 를 **노출**하고, `host` 를 **요구**한다.
/// 그 외의 것은_WORLD 에 없다 — 요구할 수 없다.
world external-parser {
    export parser;
    import host;
}
